{
  "name": "dsh-fs-extra",
  "version": "0.1.0",
  "description": "为 DeepSeek Harness 补齐文件工具缺失的删除/建目录/移动能力 —— 走进程内 fs 通路，严格遵守会话沙箱档位，不做越狱。",
  "keywords": ["deepseek-harness", "dsh", "cordis", "plugin", "filesystem", "delete", "sandbox"],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.1 <0.3.0"
  },
  "engines": { "node": ">=22.19.0" }
}
